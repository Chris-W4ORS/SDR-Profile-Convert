{
  "about": "Example rules. Copy this file to SdrConvert.rules.json to use it - the converter reads only SdrConvert.rules.json. Every example rule ships with enabled:false; switch on the ones you want and edit the values. Fields: id, dest (app or *), source (app, list, or *), match/exclude (profile-name wildcards), set (canonical path -> value), eqBaseline (points + method + useQ + target replace|cascade), enabled, note.",
  "options": {
    "Aether": {
      "txEqSource": "auto",
      "cfcLegacyMethod": "spline",
      "mapPhaseRotator": true,
      "writeRx": true,
      "compensateTrim": true,
      "multibandToEq": true,
      "limiterDrive": "none",
      "bassAmountToDriveDb": 12,
      "note": "compensateTrim: Zeus input-strip trim goes into the Aether EQ gain, so gate/de-esser thresholds placed before the EQ are lowered by the trim. multibandToEq: Zeus multiband per-band makeup gains become EQ shelves/peaks (compression itself is not carried). limiterDrive: none | compMakeup (adds the Zeus limiter drive to the Aether comp makeup so the final limiter is driven). bassAmountToDriveDb: Zeus bass amount 100% = this many dB of Aether poo drive. txEqSource auto = CFC post-EQ curve when the source is Thetis/NereusSDR (validated 2026-08-11), the TX EQ (band-for-band, with Q) when the source is Zeus/Aether. Force with cfcPost or txEq."
    },
    "Zeus": {
      "cfcLegacyMethod": "spline",
      "resetUnmappedParams": [
        "compressor",
        "noise-gate"
      ],
      "note": "Natural spline kept for legacy 10-band CFC (validated); 18-band paths always use PCHIP. resetUnmappedParams: for these units, every parameter the converter doesn't map is set to its Zeus default instead of inheriting leftover live state (add eq to include the EQ unit)."
    },
    "Nereus": {
      "fitConventionalEq": true,
      "inputCuts": "eq",
      "gateToDexp": true,
      "mirrorActiveToLive": true,
      "writeDspGlobals": true,
      "zeroPostEqWhenDisabled": false,
      "note": "zeroPostEqWhenDisabled reproduces the old Sync script's belt-and-braces zeroing; NereusSDR 2026.10 honours CFCPostEqEnabled per profile so it is off by default."
    }
  },
  "rules": [
    {
      "id": "zeus-fixed-gains",
      "dest": "Zeus",
      "match": "*",
      "set": {
        "alc.maxGainDb": 3,
        "leveler.maxGainDb": 10,
        "mic.gainDb": 0
      },
      "note": "Example: force the same ALC / leveler / mic gain on every profile written to Zeus.",
      "enabled": false
    },
    {
      "id": "vmp-g6-eq-zeus",
      "dest": "Zeus",
      "match": "VMP*",
      "eqBaseline": {
        "target": "replace",
        "method": "pchip",
        "useQ": true,
        "points": [
          {
            "freqHz": 100,
            "gainDb": -1.0,
            "q": 0.7
          },
          {
            "freqHz": 200,
            "gainDb": 0.5,
            "q": 1.3
          },
          {
            "freqHz": 550,
            "gainDb": -4.0,
            "q": 1.4
          },
          {
            "freqHz": 1000,
            "gainDb": 1.5,
            "q": 1.0
          },
          {
            "freqHz": 2400,
            "gainDb": 1.5,
            "q": 1.5
          },
          {
            "freqHz": 3500,
            "gainDb": 0.0,
            "q": 0.8
          }
        ]
      },
      "set": {
        "txEq.enabled": true
      },
      "note": "Example: replace the TX EQ of profiles whose name starts with VMP with a fixed curve (here an outboard 6-band EQ that was retired).",
      "enabled": false
    },
    {
      "id": "vmp-dynamics-zeus",
      "dest": "Zeus",
      "match": "VMP*",
      "set": {
        "compressor": {
          "enabled": true,
          "thresholdDb": -20.1,
          "ratio": 2.5,
          "attackMs": 15.6,
          "releaseMs": 104.9,
          "kneeDb": 0.7,
          "makeupDb": 0.0,
          "extra": {
            "auto-makeup": 0,
            "mix-percent": 100,
            "detector": 0,
            "sc-hpf-hz": 20,
            "release-mode": 0
          }
        },
        "noiseGate": {
          "enabled": true,
          "thresholdDb": -56.2,
          "attackMs": 10.0,
          "holdMs": 69.9,
          "releaseMs": 96.2,
          "rangeDb": -60.0,
          "outputDb": 0.0,
          "extra": {
            "mode": 0,
            "ratio": 2.0,
            "sc-hpf-hz": 20,
            "lookahead-ms": 0
          }
        }
      },
      "note": "Example: give matching profiles a fixed Zeus compressor and noise gate, with every Zeus-only parameter set explicitly.",
      "enabled": false
    },
    {
      "id": "zeus-nonvmp-dynamics-off",
      "dest": "Zeus",
      "match": "*",
      "exclude": "VMP*",
      "set": {
        "compressor.enabled": false,
        "noiseGate.enabled": false
      },
      "note": "Example: turn the Zeus compressor and gate off for every other profile.",
      "enabled": false
    },
    {
      "id": "aether-dynamics",
      "dest": "Aether",
      "source": [
        "Thetis",
        "Nereus"
      ],
      "match": "*",
      "set": {
        "compressor": {
          "enabled": true,
          "thresholdDb": -20.1,
          "ratio": 2.5,
          "attackMs": 15.6,
          "releaseMs": 104.9,
          "kneeDb": 0.7,
          "makeupDb": 0.0
        },
        "noiseGate": {
          "enabled": true,
          "thresholdDb": -56.2,
          "holdMs": 69.9,
          "releaseMs": 96.2
        }
      },
      "note": "Example: Thetis/NereusSDR have no single-band compressor or gate, so supply one when converting from them to Aether.",
      "enabled": false
    },
    {
      "id": "vmp-g6-eq-aether",
      "dest": "Aether",
      "source": [
        "Thetis",
        "Nereus"
      ],
      "match": "VMP*",
      "eqBaseline": {
        "target": "cascade",
        "method": "pchip",
        "points": [
          {
            "freqHz": 100,
            "gainDb": -1.0
          },
          {
            "freqHz": 200,
            "gainDb": 0.5
          },
          {
            "freqHz": 550,
            "gainDb": -4.0
          },
          {
            "freqHz": 1000,
            "gainDb": 1.5
          },
          {
            "freqHz": 2400,
            "gainDb": 1.5
          },
          {
            "freqHz": 3500,
            "gainDb": 0.0
          }
        ]
      },
      "note": "Example: cascade (sum in dB) a correction curve onto the Aether TX EQ for matching profiles.",
      "enabled": false
    },
    {
      "id": "aether-rx-eq",
      "dest": "Aether",
      "match": "*",
      "set": {
        "rxEq": {
          "enabled": true,
          "masterGainDb": 5.0,
          "points": [
            {
              "freqHz": 32,
              "gainDb": 3
            },
            {
              "freqHz": 63,
              "gainDb": 12
            },
            {
              "freqHz": 125,
              "gainDb": 13
            },
            {
              "freqHz": 250,
              "gainDb": 1
            },
            {
              "freqHz": 500,
              "gainDb": -8
            },
            {
              "freqHz": 1000,
              "gainDb": 3
            },
            {
              "freqHz": 2000,
              "gainDb": 4
            },
            {
              "freqHz": 4000,
              "gainDb": 5
            },
            {
              "freqHz": 8000,
              "gainDb": 0
            },
            {
              "freqHz": 16000,
              "gainDb": 0
            }
          ]
        }
      },
      "note": "Example: write a fixed RX EQ into a matching AetherRX profile.",
      "enabled": false
    }
  ]
}